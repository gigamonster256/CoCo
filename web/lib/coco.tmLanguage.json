// CoCo TextMate grammar (for Shiki / VS Code / rehype-pretty-code)
// Place in lib/coco.tmLanguage.json

{
  "name": "CoCo",
  "scopeName": "source.coco",
  "patterns": [
    {
      "name": "comment.block.coco",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "comment.line.coco",
      "match": "//.*$"
    },
    {
      "name": "keyword.control.coco",
      "match": "\\b(main|function|call|return|if|then|else|fi|while|do|od|repeat|until)\\b"
    },
    {
      "name": "storage.type.coco",
      "match": "\\b(int|float|bool|void)\\b"
    },
    {
      "name": "constant.language.coco",
      "match": "\\b(true|false)\\b"
    },
    {
      "name": "keyword.operator.coco",
      "match": "==|!=|<=|>=|<|>|\\+=|-=|\\*=|/=|%=|\\^=|\\+\\+|--|\\+|-|\\*|/|%|\\^|="
    },
    {
      "name": "keyword.operator.logical.coco",
      "match": "\\b(and|or|not)\\b"
    },
    {
      "name": "constant.numeric.coco",
      "match": "-?\\d+(\\.\\d+)?"
    },
    {
      "name": "entity.name.function.coco",
      "match": "\\b[a-zA-Z][a-zA-Z\\d_]*\\s*(?=\\()"
    },
    {
      "name": "variable.other.coco",
      "match": "\\b[a-zA-Z][a-zA-Z\\d_]*\\b"
    }
  ],
  "repository": {}
}
